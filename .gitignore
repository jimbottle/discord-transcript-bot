# Secrets and local settings (op.env holds 1Password references; .env is a
# derived copy and must never be committed).
/.env
/op.env

# Python
__pycache__/
venv/
.venv/

# The roster maps Discord ids to real names: keep it off the public repo.
player_map.yml
player_map.yaml

# Everything the bot writes at run time.
.logs/
transcripts/
# Captured session audio: multi-GB of recorded voices, never committed
captures/
.DS_Store
**/.claude/settings.local.json
# roborev snapshots
/.roborev/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# beads tracker state is local-only (decision 2026-10-20): never commit the export
.beads/

# Library content stays on this machine: the GitHub repo is public and the
# notes are the GM's private material (including spoilers players must not
# read). Only the README, the example config and the example note are tracked.
/library/*
!/library/README.md
!/library/library.example.yml
!/library/example-note.md
# Per-recording session tags (transcripts/ is already ignored; explicit
# so moving transcripts never leaks them).
*.meta.json

# Question history (question_log.py): answers can quote GM notes.
/history/
