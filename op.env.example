# 1Password references for the bot's secrets. Copy to op.env (gitignored)
# and run the bot with `op run --env-file=op.env -- ./venv/bin/python main.py`;
# `make start` and `make capture-session` do that automatically when op.env
# exists. Values are resolved by the 1Password CLI at run time and never
# touch disk. Item naming convention: <repo>-<service>, fields named after
# the env var (see the Secrets section of CLAUDE.md).
ANTHROPIC_API_KEY=op://Personal/dtb-anthropic/ANTHROPIC_API_KEY
# Pending migration out of the literal .env:
# DISCORD_BOT_TOKEN=op://Personal/dtb-discord/DISCORD_BOT_TOKEN
