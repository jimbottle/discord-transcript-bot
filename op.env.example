# 1Password references for the bot's secrets. Copy to op.env (gitignored)
# and run the bot with `op run --env-file=op.env -- ./venv/bin/python main.py`;
# `make start` and `make capture-session` do that automatically when op.env
# exists. Values are resolved by the 1Password CLI at run time and never
# touch disk. New items follow the <repo>-<service> naming convention with
# fields named after the env var (see the Secrets section of CLAUDE.md);
# an existing item may be referenced by ID with whatever field it has.
# Item "Anthropic - evan.j.ray@gmail.com - Discord Transcript Bot" (API Credential;
# the value is in its `key` field), referenced by ID so a rename cannot break it.
ANTHROPIC_API_KEY=op://Credentials/edgnovygji3let3vmtilywnsae/credential
