# For Discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
PLAYER_MAP_FILE_PATH="./player_map.yml"

# ── /ask ─────────────────────────────────────────────────────────────
# /ask answers questions about the live transcript with Claude. The key
# belongs in 1Password and is loaded with `op run` (see op.env.example);
# putting a literal value here is a stopgap, not the pattern.
ANTHROPIC_API_KEY=
# Optional: model and reasoning effort (low | medium | high). Defaults:
# ASK_MODEL=claude-opus-5-5
# CAMPAIGN_GM_NOTES=1   # let /ask read audience: gm notes (spoilers); off by default
# CAMPAIGN_NOTES_DIR=   # override campaign/notes
# ASK_EFFORT=medium
