# ── Discord ──────────────────────────────────────────────────────────
# The bot token from the Developer Portal. Prefer loading it from a secrets
# manager at run time (op.env.example); a value here is a stopgap.
DISCORD_BOT_TOKEN=
# Roster file mapping Discord user ids to player and character names;
# /update_player_map creates it, /add_player and the dashboard edit it.
PLAYER_MAP_FILE_PATH="./player_map.yml"
# TRANSCRIPTION_METHOD=local   # or "openai" (then set OPENAI_API_KEY)

# ── /ask, /recap and the dashboard's questions ───────────────────────
# Recommended: a local model (free, nothing leaves the machine). Install
# Ollama, `ollama pull gemma4:26b`, and leave these as they are. See README
# "Questions about the session".
ASK_PROVIDER=local
LOCAL_LLM_MODEL=gemma4:26b
# LOCAL_LLM_URL=http://localhost:11434/v1   # Ollama; LM Studio, llama-server, vLLM work too
# LOCAL_LLM_API_KEY=                        # only if your server wants one
# LOCAL_LLM_TIMEOUT_S=840                   # the first question on a long session is slow
# LOCAL_LLM_MAX_TRANSCRIPT_CHARS=100000     # how much of the session it reads (the most recent part); 0 = all

# Or the Anthropic API: set ASK_PROVIDER=anthropic and provide the key. Keep
# the key in a secrets manager and load it at run time (see op.env.example);
# a literal value here is a stopgap.
# ANTHROPIC_API_KEY=
# ASK_MODEL=claude-opus-5-5
# ASK_EFFORT=medium                         # low | medium | high

# Either provider:
# CAMPAIGN_GM_NOTES=1   # let /ask read audience: gm notes (spoilers); off by default
# LIBRARY_DIR=          # override library/ (games, groups, campaigns, notes)
# SESSION_DAY_CUTOFF_HOUR=6   # recordings before this hour count as the previous night
# TABLE_GUARD=on        # GM check on every question (off only for a GM-only setup)
# GUARD_MODEL=          # default: LOCAL_LLM_MODEL locally, claude-haiku-5-5 on Anthropic
