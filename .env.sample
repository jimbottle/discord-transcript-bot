# For Discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
PLAYER_MAP_FILE_PATH="./player_map.yml"

# Optional: Ollama model used by the /ask command. Defaults to gemma4:26b,
# the pick from the bake-off in the sibling local-models repo
# (prompts/discord_ask.json). Must be a name Ollama can pull —
# `ai/`-prefixed names are Docker Hub's and its registry 404s them.
# Install with: ollama pull gemma4:26b
# ASK_OLLAMA_MODEL=gemma4:26b

# ── /ask language-model providers ────────────────────────────────────
# /ask walks a chain: OpenRouter (primary) → Cerebras paid (fallback) →
# local Ollama (last resort). Each tier is skipped when unconfigured, so
# any subset works; with none set, /ask uses Ollama alone.
OPENROUTER_API_KEY=
# Optional overrides. The default is nvidia/nemotron-3-super-120b-a12b —
# 1M context (a whole session transcript is the prompt) at $0.085/M in.
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

CEREBRAS_PAID_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Set to 1 to make /ask cloud-only (drops the local Ollama last resort).
# ASK_DISABLE_OLLAMA=
